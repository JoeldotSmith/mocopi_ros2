Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /TF1
        - /Axes1
      Splitter Ratio: 0.5
    Tree Height: 549
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: pelvis
      Value: true

    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Robot Model
      Robot Description: /robot_description
      Description Topic: /robot_description
      Alpha: 1
      Collision Enabled: false
      Update Interval: 0
      Visual Enabled: true

    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
        pelvis: {Value: true}
        head: {Value: true}
        l_foot: {Value: true}
        l_hand: {Value: true}
        l_low_arm: {Value: true}
        l_low_leg: {Value: true}
        l_shoulder: {Value: true}
        l_toes: {Value: true}
        l_up_arm: {Value: true}
        l_up_leg: {Value: true}
        neck_1: {Value: true}
        neck_2: {Value: true}
        r_foot: {Value: true}
        r_hand: {Value: true}
        r_low_arm: {Value: true}
        r_low_leg: {Value: true}
        r_shoulder: {Value: true}
        r_toes: {Value: true}
        r_up_arm: {Value: true}
        r_up_leg: {Value: true}
        torso_1: {Value: true}
        torso_2: {Value: true}
        torso_3: {Value: true}
        torso_4: {Value: true}
        torso_5: {Value: true}
        torso_6: {Value: true}
        torso_7: {Value: true}
      Marker Alpha: 1
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: false
      Show Names: true
      Tree:
        pelvis:  
          l_up_leg:
            l_low_leg:
              l_foot:
                l_toes: {}
          r_up_leg:
            r_low_leg:
              r_foot:
                r_toes: {}
          torso_1:
            torso_2:
              torso_3:
                torso_4:
                  torso_5:
                    torso_6:
                      l_shoulder:
                        l_up_arm:
                          l_low_arm:
                            l_hand: {}
                      r_shoulder:
                        r_up_arm:
                          r_low_arm:
                            r_hand: {}
                      torso_7:
                        neck_1:
                          neck_2:
                            head: {}
      Update Interval: 0
      Value: true

    - Alpha: 1
      Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.1
      Name: Robot Base Axes
      Radius: 0.02
      Reference Frame: pelvis  
      Show Trail: false
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: pelvis  
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Theta std deviation: 0.2618
      Topic: /initialpose
      X std deviation: 0.5
      Y std deviation: 0.5
    - Class: rviz_default_plugins/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.0
      Enable Stereo Rendering: false
      Field of View: 0.7854
      Focal Point: {X: -0.2, Y: -0.25, Z: 0.9}
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: -0.01
      Target Frame: pelvis  # Changed from <Fixed Frame>
      Yaw: 0.02

Window Geometry:
  Displays: {collapsed: false}
  Height: 846
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 000000ff00000000fd000000040000000000000156000002b0fc0200000008fb... [truncated]
  Selection: {collapsed: false}
  Time: {collapsed: false}
  Tool Properties: {collapsed: false}
  Views: {collapsed: false}
  Width: 1200
  X: 72
  Y: 27
